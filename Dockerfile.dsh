FROM node:22-bookworm-slim

ARG DSH_VERSION=0.1.1-rc.2
ENV DSH_VERSION=${DSH_VERSION}
ENV DSH_HOME=/home/node/.dsh
ENV NODE_ENV=production
WORKDIR /opt/miaozao

RUN npm install --global --omit=dev "@deepseek-ai/dsh@${DSH_VERSION}" \
    && mkdir -p /home/node/.dsh \
    && chown -R node:node /home/node /opt/miaozao
COPY --chown=node:node dsh-config/profiles /opt/miaozao/dsh-profiles
COPY --chown=node:node dsh-config/home/cordis.patch.yml /opt/miaozao/cordis.patch.yml
COPY --chown=node:node dsh-config/dsh-proxy.mjs /opt/miaozao/dsh-proxy.mjs
COPY --chown=node:node dsh-config/dsh-entrypoint.sh /opt/miaozao/dsh-entrypoint.sh
RUN chmod 0755 /opt/miaozao/dsh-entrypoint.sh

USER node
EXPOSE 8080
ENTRYPOINT ["/opt/miaozao/dsh-entrypoint.sh"]

