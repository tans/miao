# MIAO runtime configuration example. Business settings (registration, mail,
# AI/Jev credentials, platform admins, backup policy) live in the database and
# are managed through the admin console; see docs/OPERATIONS.md.
MIAO_ADMIN_EMAILS=admin@example.com
MIAO_SETTINGS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
MIAO_DATA_DIR=
MIAO_PORT=41874
HOST=0.0.0.0
