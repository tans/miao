{
  "id": "orders",
  "name": "订单与库存台",
  "command": "order",
  "icon": "shopping-cart",
  "description": "商品、库存和订单状态跟踪。",
  "definition": {
    "schema_version": 1,
    "name": "订单与库存台",
    "description": "商品、库存与订单跟踪",
    "tables": [
      {"name": "商品", "slug": "products", "fields": [
        {"name": "name", "label": "商品名称", "type": "text", "required": true},
        {"name": "sku", "label": "货号", "type": "text", "required": true},
        {"name": "price", "label": "单价", "type": "number", "required": true},
        {"name": "stock", "label": "库存", "type": "number"}
      ]},
      {"name": "订单", "slug": "orders", "fields": [
        {"name": "code", "label": "订单号", "type": "text", "required": true},
        {"name": "product", "label": "商品", "type": "relation", "target": "products", "required": true},
        {"name": "quantity", "label": "数量", "type": "number", "required": true},
        {"name": "status", "label": "状态", "type": "select", "options": ["待付款", "已付款", "已发货", "已完成"], "required": true},
        {"name": "amount", "label": "金额", "type": "number"}
      ]}
    ]
  }
}
