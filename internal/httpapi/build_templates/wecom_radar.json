{
  "id": "wecom_radar",
  "name": "企微洞察雷达",
  "command": "wecom-radar",
  "icon": "briefcase",
  "description": "设置主题后按每日计划采集公开企业微信内容来源，生成可追溯的每日报告。",
  "definition": {
    "schema_version": 1,
    "name": "企微洞察雷达",
    "description": "主题配置、每日报告与公开来源采集脚本",
    "tables": [
      {"name": "主题配置", "slug": "topics", "fields": [
        {"name": "name", "label": "主题名称", "type": "text", "required": true},
        {"name": "keywords", "label": "关键词", "type": "text"},
        {"name": "source_url", "label": "来源地址", "type": "url"},
        {"name": "source_type", "label": "来源类型", "type": "text"},
        {"name": "notes", "label": "抓取声明", "type": "text"},
        {"name": "enabled", "label": "启用状态", "type": "bool"}
      ]},
      {"name": "每日报告", "slug": "daily_reports", "fields": [
        {"name": "report_date", "label": "报告日期", "type": "date"},
        {"name": "topic", "label": "主题", "type": "text"},
        {"name": "title", "label": "标题", "type": "text", "required": true},
        {"name": "summary", "label": "摘要", "type": "text"},
        {"name": "source_url", "label": "来源链接", "type": "url", "required": true},
        {"name": "published_at", "label": "发布时间", "type": "date"},
        {"name": "insight", "label": "洞察内容", "type": "text"}
      ]}
    ],
    "collection_scripts": [
      {
        "name": "每日企微洞察采集",
        "description": "每天 09:00（Asia/Shanghai）抓取企业微信公开官网页面并写入每日报告，按来源链接去重。企业微信内部内容需要成员权限，模板只使用公开页面作为来源；启用前请在采集配置页审阅来源与选择器，无法访问时运行记录会保留阻塞原因。",
        "definition": {
          "source": {
            "url": "https://work.weixin.qq.com",
            "extract": {
              "format": "html",
              "item_selector": "a",
              "fields": {
                "title": {"selector": "a"},
                "url": {"selector": "a", "attribute": "href"}
              }
            }
          },
          "target": {
            "table": "daily_reports",
            "fields": {
              "title": {"from": "title"},
              "source_url": {"from": "url"}
            }
          },
          "dedup": {"fields": ["url"], "on_change": "skip"},
          "recipients": [],
          "baseline": "notify",
          "schedule": {"type": "daily", "time": "09:00", "timezone": "Asia/Shanghai"}
        }
      }
    ]
  }
}
