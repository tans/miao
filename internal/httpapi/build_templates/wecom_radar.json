{
  "id": "wecom_radar",
  "name": "企微洞察雷达",
  "command": "wecom-radar",
  "icon": "briefcase",
  "description": "填入第三方企业微信内容接口，按每日计划生成洞察日报。",
  "definition": {
    "schema_version": 1,
    "name": "企微洞察雷达",
    "description": "第三方接口配置、每日报告与每日采集脚本",
    "tables": [
      {"name": "主题配置", "slug": "topics", "fields": [
        {"name": "name", "label": "主题名称", "type": "text", "required": true},
        {"name": "keywords", "label": "关键词", "type": "text"},
        {"name": "source_url", "label": "第三方接口地址", "type": "url"},
        {"name": "source_type", "label": "接口类型", "type": "text"},
        {"name": "notes", "label": "接口参数与说明", "type": "text"},
        {"name": "enabled", "label": "启用状态", "type": "bool"}
      ]},
      {"name": "每日报告", "slug": "daily_reports", "fields": [
        {"name": "report_date", "label": "报告日期", "type": "date"},
        {"name": "topic", "label": "主题", "type": "text"},
        {"name": "title", "label": "标题", "type": "text", "required": true},
        {"name": "summary", "label": "摘要", "type": "text"},
        {"name": "source_url", "label": "来源链接", "type": "url", "required": true},
        {"name": "published_at", "label": "发布时间", "type": "date"},
        {"name": "insight", "label": "洞察内容", "type": "text"}
      ]}
    ],
    "collection_scripts": [
      {
        "name": "每日企微洞察采集",
        "description": "每天 09:00（Asia/Shanghai）调用第三方接口并写入每日报告，按来源链接去重。默认来源为占位地址 https://api.example.com/v1/daily-report：启用前请在采集配置页替换为你的第三方接口地址，并按接口返回调整字段映射与去重键。模板不内置任何平台抓取逻辑；接口不可访问时运行记录保留阻塞原因，不会写入演示数据。",
        "definition": {
          "source": {
            "url": "https://api.example.com/v1/daily-report"
          },
          "target": {
            "table": "daily_reports",
            "fields": {
              "title": {"from": "title"},
              "source_url": {"from": "url"}
            }
          },
          "dedup": {"fields": ["url"], "on_change": "skip"},
          "recipients": [],
          "baseline": "notify",
          "schedule": {"type": "daily", "time": "09:00", "timezone": "Asia/Shanghai"}
        }
      }
    ]
  }
}
