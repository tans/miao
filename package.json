{
  "name": "miao-platform",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10",
  "type": "module",
  "scripts": {
    "prepare:fx": "node scripts/prepare-fx-assets.js",
    "build": "bash scripts/build.sh",
    "test": "go test ./...",
    "start": "npm run prepare:fx && go run .",
    "dev": "npm run prepare:fx && go run .",
    "server:install": "bash scripts/install.sh",
    "server:start": "bash scripts/start.sh",
    "server:stop": "bash scripts/stop.sh",
    "server:status": "bash scripts/status.sh",
    "server:logs": "bash scripts/logs.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test:race": "go test -race ./...",
    "test:runtime": "bash scripts/test-runtime.sh",
    "check": "go vet ./... && git diff --check",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "libfx": "0.0.11"
  }
}
