{
  "name": "miao-platform",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:assets": "bash scripts/build-assets.sh",
    "test": "go test ./...",
    "start": "go run .",
    "dev": "go run .",
    "server:install": "bash scripts/install.sh",
    "server:start": "bash scripts/start.sh",
    "server:stop": "bash scripts/stop.sh",
    "server:status": "bash scripts/status.sh",
    "server:logs": "bash scripts/logs.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "check": "go vet ./... && git diff --check",
    "package": "bash scripts/package.sh",
    "docs": "go generate ./...",
    "docs:check": "go generate ./... && git diff --exit-code -- docs/generated"
  },
  "dependencies": {
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "esbuild": "0.25.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.47",
    "tailwindcss": "4.3.3"
  }
}
