{
  "name": "miao-platform",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10",
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "go test ./...",
    "start": "go run .",
    "dev": "go run .",
    "server:install": "bash scripts/install.sh",
    "server:start": "bash scripts/start.sh",
    "server:stop": "bash scripts/stop.sh",
    "server:status": "bash scripts/status.sh",
    "server:logs": "bash scripts/logs.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test:race": "go test -race ./...",
    "check": "go vet ./... && git diff --check",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "esbuild": "0.25.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  }
}
