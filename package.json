{
  "name": "miao-platform",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "type": "module",
  "scripts": {
    "prepare:fx": "bun scripts/prepare-fx-assets.js",
    "start": "bun run prepare:fx && bun src/server.js",
    "dev": "bun run prepare:fx && bun --watch src/server.js",
    "server:install": "bash scripts/install.sh",
    "server:start": "bash scripts/start.sh",
    "server:stop": "bash scripts/stop.sh",
    "server:status": "bash scripts/status.sh",
    "server:logs": "bash scripts/logs.sh",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "libfx": "^0.0.11",
    "pm2": "6.0.5",
    "pocketbase": "^0.28.1"
  }
}
